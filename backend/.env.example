# Environment Configuration for Samjho Backend
APP_NAME=Samjho
ENVIRONMENT=development
VERSION=1.0.0
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_STRING=60/minute
SLIGHTLY_OUTSIDE_THRESHOLD=0.10
DRUG_MATCH_THRESHOLD=75.0

# Optional hosted LLM / OCR provider keys (Fallback uses built-in rule and RAG engines)
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
